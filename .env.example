# MedRemind Environment Configuration Example
# Copy this file to .env.local for local development.

# --- Supabase Settings ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- Web Push (VAPID) Settings ---
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExampleVapidPublicKeyHere...
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:support@medremind.local

# --- Application & Cron Security ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# Secret token to protect /api/notifications/cron endpoint from unauthorized callers
CRON_SECRET=your-secure-random-cron-secret-token

# --- OCR & NER Configuration ---
# Options: 'browser-ner' (default, free offline regex+matcher), 'tesseract', 'server-llm'
OCR_SERVICE_PROVIDER=browser-ner
# Optional: Only needed if OCR_SERVICE_PROVIDER=server-llm
GEMINI_API_KEY=your-optional-gemini-key
